# Environments
venv/
env/
.env

# Python Cache
__pycache__/
*.py[cod]

# PyCharm specific
.idea/

# SCADA Data & Logs
# Machine data written by the running system. NOTE: .gitignore doesn't affect files that
# are already tracked - see TODO_control_hardening.md for untracking the parquet data safely.
data/daily_logs/
data/parquet_logs/
data/events.db
data/events.db-shm
data/events.db-wal
# Alarm acknowledgements and shelves (service_alarms)
data/alarm_state.json
data/alarm_state.json.tmp
# F12 capture: the thesis figure texts changed in its dialog (per machine)
data/figure_text.json
data/figure_text.json.tmp
# Services stopped on purpose from the launcher (src/launcher/programs.py)
data/launcher_state_*.json
data/launcher_state_*.json.tmp
data/telemetry/
# Data viewer's saved plot settings (per machine)
config/plot_settings.json
config/workspace_profiles.json
config/workspace_profiles.json.tmp
data/exports/
data/scans/
FaultLogs/
SystemLogs/
SystemLogsBin/
*.npz
*.log
# Simulator data (run_simulation / --sim) and test caches
data_sim/
.pytest_cache/
config/backups/
config/*.tmp

# Per-machine look (theme chosen in View > Theme), shared by the HMI and the viewer
config/appearance.json

# This machine's own config values (src/core/lab_config.py): the repository's config/*.json with
# these on top. Never in git, so software updates never meet them.
config/lab/
# The software updater's state and the files it keeps for going back (src/launcher/updater.py), and a
# file it is writing
data/updates/
*.update-tmp
# The tag registry: built on each machine from its config files (src/utils/build_registry.py)
config/system_tags.json
config/system_tags.json.tmp
