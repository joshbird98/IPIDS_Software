{
  "recipe_name": "Non-Destructive System Dry Run",
  "version": "1.2",
  "description": "Moves the Faraday cup in and out and degausses the analyser magnet. The degauss is done with the cup in: it sweeps the magnet current, so with the cup out every mass would reach the sample. It needs the safety relay on, for the degauss.",
  "fault_policy": [
    { "type": "BIT_FAULT", "registry_tag": "ion_beam.faults.word_0_system", "bit_str": "0.1", "name": "Safety_Relay_Tripped", "action": "ABORT" }
  ],
  "steps": [
    { "step_id": 1, "type": "ACTION", "target": "ion_beam.beamline.diagnostics.cmd_insert_fc", "value": true, "comment": "Insert Faraday Cup" },
    { "step_id": 2, "type": "WAIT_TELEMETRY", "target": "ion_beam.beamline.diagnostics.stat_fc_inserted", "condition": "==", "value": 1.0, "timeout_sec": 10.0, "comment": "Verify Cup is Inserted" },
    { "step_id": 3, "type": "WAIT_TIME", "duration_sec": 2.5, "comment": "Wait for settling" },
    { "step_id": 4, "type": "WAIT_TELEMETRY", "target": "ion_beam.facilities.safety_relay_active", "condition": "==", "value": 1.0, "timeout_sec": 10.0, "comment": "Safety relay on (the magnet service won't degauss without it)" },
    { "step_id": 5, "type": "ACTION", "target": "ion_beam.beamline.magnet.cmd_degauss", "value": true, "comment": "Start Magnet Degauss (cup in)" },
    { "step_id": 6, "type": "WAIT_TELEMETRY", "target": "ion_beam.beamline.magnet.stat_degaussing", "condition": "==", "value": 1.0, "timeout_sec": 5.0, "comment": "Wait for Degauss Active" },
    { "step_id": 7, "type": "WAIT_TELEMETRY", "target": "ion_beam.beamline.magnet.stat_degaussing", "condition": "==", "value": 0.0, "timeout_sec": 300.0, "comment": "Wait for Degauss Complete (about 2 minutes)" },
    { "step_id": 8, "type": "ACTION", "target": "ion_beam.beamline.diagnostics.cmd_insert_fc", "value": false, "comment": "Retract Faraday Cup" },
    { "step_id": 9, "type": "WAIT_TELEMETRY", "target": "ion_beam.beamline.diagnostics.stat_fc_retracted", "condition": "==", "value": 1.0, "timeout_sec": 10.0, "comment": "Verify Cup is Retracted" }
  ]
}
