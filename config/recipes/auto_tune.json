{
  "recipe_name": "Automated Mass Resolution",
  "version": "1.1",
  "fault_policy": [],
  "steps": [
    {
      "step_id": 1,
      "type": "ACTION",
      "target": "ion_beam.beamline.diagnostics.cmd_insert_fc",
      "value": true,
      "comment": "Ensure Faraday Cup is inserted"
    },
    {
      "step_id": 2,
      "type": "ROUTINE_CALL",
      "routine_name": "mass_scan",
      "parameters": {
        "start_a": 20.0,
        "stop_a": 30.0,
        "step_a": 0.05,
        "samples": 5,
        "nplc": 1.0,
        "goto_peak": true
      },
      "comment": "Mass scan 20-30 A, then set the magnet on the strongest peak"
    },
    {
      "step_id": 3,
      "type": "WAIT_TIME",
      "duration_sec": 2.0,
      "comment": "Wait for Magnet to settle on peak"
    }
  ]
}
