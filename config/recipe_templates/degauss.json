{
  "recipe_name": "Degauss the analyser magnet, with the Faraday cup in",
  "version": "1.0",
  "description": "A degauss sweeps the magnet current: with the cup in, no other mass reaches the sample meanwhile.",
  "fault_policy": [],
  "steps": [
    {
      "step_id": 1,
      "type": "VERIFIED_ACTION",
      "target": "ion_beam.beamline.diagnostics.cmd_insert_fc",
      "value": true,
      "verify_target": "ion_beam.beamline.diagnostics.stat_fc_inserted",
      "verify_condition": "==",
      "verify_value": 1,
      "timeout_sec": 15.0,
      "comment": "Faraday cup in"
    },
    {
      "step_id": 2,
      "type": "ACTION",
      "target": "ion_beam.beamline.magnet.cmd_degauss",
      "value": true,
      "comment": "Start the degauss"
    },
    {
      "step_id": 3,
      "type": "WAIT_TELEMETRY",
      "target": "ion_beam.beamline.magnet.stat_degaussing",
      "condition": "==",
      "value": 1,
      "timeout_sec": 10.0,
      "comment": "The degauss has started"
    },
    {
      "step_id": 4,
      "type": "WAIT_TELEMETRY",
      "target": "ion_beam.beamline.magnet.stat_degaussing",
      "condition": "==",
      "value": 0,
      "timeout_sec": 300.0,
      "comment": "The degauss has finished"
    }
  ]
}
