{
  "recipe_name": "Mass scan: magnet on, cup in and biased, scan, then the biggest peak",
  "version": "1.0",
  "description": "Everything a scan needs, then the scan: the magnet on, the Faraday cup in and biased above 50 V. Set the range for the beam energy you run at.",
  "fault_policy": [
    {
      "type": "BIT_FAULT",
      "registry_tag": "ion_beam.faults.word_0_system",
      "bit_str": "0.1",
      "name": "Safety_Relay_Tripped",
      "action": "ABORT"
    }
  ],
  "steps": [
    {
      "step_id": 1,
      "type": "ROUTINE_CALL",
      "routine_name": "psu_control",
      "parameters": {
        "cmd_enable": "ion_beam.beamline.magnet.cmd_enable",
        "stat_enabled": "ion_beam.beamline.magnet.stat_enabled",
        "sp_tag": "ion_beam.beamline.magnet.sp_requested_current",
        "rb_tag": "ion_beam.beamline.magnet.rb_current",
        "target_val": 20.0,
        "wait_for_readback": true,
        "tolerance": 0.05,
        "timeout_sec": 60.0,
        "requires_relay": true
      },
      "comment": "Analyser magnet on, at the start of the scan"
    },
    {
      "step_id": 2,
      "type": "VERIFIED_ACTION",
      "target": "ion_beam.beamline.diagnostics.cmd_insert_fc",
      "value": true,
      "verify_target": "ion_beam.beamline.diagnostics.stat_fc_inserted",
      "verify_condition": "==",
      "verify_value": 1,
      "timeout_sec": 15.0,
      "comment": "Faraday cup in"
    },
    {
      "step_id": 3,
      "type": "ROUTINE_CALL",
      "routine_name": "psu_control",
      "parameters": {
        "cmd_enable": "ion_beam.beamline.faraday.smu.cmd_enable",
        "stat_enabled": "ion_beam.beamline.faraday.smu.stat_enabled",
        "sp_tag": "ion_beam.beamline.faraday.smu.sp_requested_voltage",
        "rb_tag": "ion_beam.beamline.faraday.smu.rb_voltage",
        "target_val": 60.0,
        "wait_for_readback": true,
        "tolerance": 1.0,
        "timeout_sec": 20.0,
        "requires_relay": true
      },
      "comment": "Cup bias on: above 50 V for a correct beam current"
    },
    {
      "step_id": 4,
      "type": "ROUTINE_CALL",
      "routine_name": "mass_scan",
      "parameters": {
        "start_a": 20.0,
        "stop_a": 30.0,
        "step_a": 0.05,
        "samples": 5,
        "nplc": 1.0,
        "goto_peak": true
      },
      "comment": "Scan, then set the magnet on the biggest peak"
    },
    {
      "step_id": 5,
      "type": "WAIT_TIME",
      "duration_sec": 2.0,
      "comment": "The magnet settles on the peak"
    }
  ]
}
