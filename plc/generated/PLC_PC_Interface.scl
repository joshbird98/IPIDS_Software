DATA_BLOCK "DB_PC_Interface"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT
      // =====================================================================
      // TO PC: READ-ONLY FOR PYTHON
      // The PLC continuously overwrites this block from its internal logic.
      // Python (HMI/Recipe Manager) reads this as the "Single Source of Truth"
      // for the current machine state. NEVER write to this from Python.
      // =====================================================================
      To_PC : STRUCT
         System : STRUCT
            PC_PLC_Comms_Lost : Bool;           // TRUE if watchdog fails
            Remote_IO_Lost : Bool;              // TRUE if Profinet/EtherCAT node drops
            Src_Auto_SDown : Bool;              // TRUE if automated shutdown sequence is active
            Machine_State : Int;                // 0=Init, 1=Safe/Not Ready, 2=Ready, 3=Live/HV, 99=Fault
            PLC_Cycle_Count : DInt;             // Heartbeat counter for PC to monitor PLC health
            Remote_Shutdown_Step : Int;         // 0=OK, 1=Hold, 2=Cooling, 3=Tripped, 99=Latched
            PC_Shutdown_Step : Int;             // 0=OK, 1=Hold, 2=Cooling, 3=Tripped, 99=Latched
            Safety_Timer_Elapsed_ms : DInt;     // The elapsed time for the safety relay timer | unit=ms
            Safety_Timer_Total_ms : DInt;       // The total time the enable safety relay command latches for | unit=ms
         END_STRUCT;

         Faults : STRUCT
            Word_0 : "UDT_Fault_Word_0_System";
            Word_1 : "UDT_Fault_Word_1_Pumps";
            Word_2 : "UDT_Fault_Word_2_Source";
            Word_3 : "UDT_Fault_Word_3_Spellman";
            Word_4 : "UDT_Fault_Word_4_Magnet";
            Word_5 : "UDT_Fault_Word_5_Gauges";
         END_STRUCT;

         Facilities : STRUCT
            Safety_Relay_Active : Bool;   // TRUE when physical safety contactors are closed
            Stat_Src_Coolant_OK : Bool;   // Source syltherm flow switch OK
            Stat_Air_Press_OK : Bool;     // Compressed air pressure switch OK
            Stat_Mag_Coolant_OK : Bool;   // Magnet water flow and thermal-cutoff switch OK
         END_STRUCT;

         Source_Extraction : STRUCT
            Stat_Enabled : Bool;          // Hardware state: TRUE = HV Contactor Closed
            RB_Voltage : Real;            // Physical Readback (ADC) | unit=kV
            RB_Current : Real;            // Physical Readback (ADC) | unit=mA
            RB_Power : Real;              // Calculated power | unit=W
            SP_Actual_Voltage : Real;     // Active Setpoint currently driving the DAC | unit=kV
            Ctrl_Mode : Int;              // 0=Manual, 1=PLC Auto, 2=Recipe, 4=Arc-Quench
            Stat_Lockout : Bool;          // TRUE if interlock blocks enabling/changing SP
         END_STRUCT;

         Source_Target : STRUCT
            Stat_Enabled : Bool;          // Hardware state: TRUE = HV Contactor Closed
            RB_Voltage : Real;            // Physical Readback (ADC) | unit=kV
            RB_Current : Real;            // Physical Readback (ADC) | unit=mA
            RB_Power : Real;              // Calculated power | unit=W
            SP_Actual_Voltage : Real;     // Active Setpoint currently driving the DAC | unit=kV
            Ctrl_Mode : Int;              // 0=Manual, 1=PLC Auto, 2=Recipe, 4=Arc-Quench
            Stat_Lockout : Bool;          // TRUE if interlock blocks enabling/changing SP
         END_STRUCT;

         Source_Filament : STRUCT
            Stat_Enabled : Bool;          // Hardware state: TRUE = Contactor Closed
            Stat_Disarming : Bool;        // Rampdown happening
            RB_Voltage : Real;            // Physical Readback (ADC) | unit=V
            RB_Current : Real;            // Physical Readback (ADC) | unit=A
            RB_Power : Real;              // Calculated power | unit=W
            Resistance : Real;            // Calculated resistance of filament | unit=mΩ
            SP_Actual_Current : Real;     // Active Setpoint currently driving the DAC | unit=A
            Ctrl_Mode : Int;              // 0=Manual, 1=PLC Auto, 2=Recipe, 3=Cascaded (PID Slave)
            Stat_Lockout : Bool;          // TRUE if interlock blocks enabling/changing SP
            Out_CV_Current : Real;        // Raw PID Control Variable output for diagnostics | unit=%
         END_STRUCT;

         Source_Thermionic : STRUCT
            Stat_Enabled : Bool;          // Hardware state: TRUE = Contactor Closed
            Stat_Auto_Emission : Bool;    // TRUE = PID loop is controlling Filament
            RB_Voltage : Real;            // Physical Readback (ADC) | unit=V
            RB_Current : Real;            // Physical Readback (ADC) | unit=mA
            RB_Power : Real;              // Calculated power | unit=W
            SP_Actual_Current : Real;     // Active Setpoint currently driving the DAC | unit=mA
            Ctrl_Mode : Int;              // 0=Manual, 1=PLC Auto, 2=Recipe, 4=Arc-Quench
            Stat_Lockout : Bool;          // TRUE if interlock blocks enabling/changing SP
         END_STRUCT;

         Source_Cesium : STRUCT
            Stat_Enabled : Bool;          // Hardware state: TRUE = Heater Contactor Closed
            RB_Temp : Real;               // Physical Readback (Thermocouple) | unit=°C
            SP_Actual_Temp : Real;        // Active Setpoint currently driving the PID | unit=°C
            Ctrl_Mode : Int;              // 0=Manual, 1=PLC Auto, 2=Recipe
            Stat_Lockout : Bool;          // TRUE if interlock blocks enabling/changing SP
            Out_CV_Heating : Real;        // PID Heating Duty Cycle | unit=%
            Stat_Cooling_Active : Bool;   // TRUE if pneumatic cooler valve is energized
            Stat_Cooling_Wait : Bool;     // TRUE if cooling is demanded but air compressor is resting
            Estimated_Temp : Real;        // Estimated temperature from internal model | unit=°C
         END_STRUCT;

         Source_Chamber : STRUCT
            Stat_GV_Open : Bool;                // Limit switch: Gate Valve is fully open
            Stat_GV_Closed : Bool;              // Limit switch: Gate Valve is fully closed
            Stat_GV_Open_Permissive : Bool;     // TRUE if vacuum differential allows opening
            Stat_GV_Close_Permissive : Bool;    // TRUE if beam is dead and safe to close
            RB_Body_Temp : Real;                // Physical Readback (Thermocouple) | unit=°C
         END_STRUCT;

         Beamline_Steering : STRUCT
            Stat_Enabled : Bool;            // True, analog output enabled
            SP_Actual_X_Volts : Real;       // Active setpoint currently driving the AO | unit=V
            SP_Actual_Y_Volts : Real;       // Active setpoint currently driving the AO | unit=V
            Ctrl_Mode : Int;                // 0=Manual, 1=PLC Auto, 2=Recipe
            Stat_Lockout : Bool;            // True when the PLC forces control
         END_STRUCT;

         Beamline_Diagnostics : STRUCT
            Stat_FC_Inserted : Bool;        // Mapped from inferred state model
            Stat_FC_Retracted : Bool;       // Mapped from inferred state model
            Ctrl_Mode : Int;                // 0=Manual, 1=PLC Auto, 2=Recipe
            Stat_Lockout : Bool;            // True when the PLC forces control
         END_STRUCT;

         Endstation : STRUCT
            RB_Dose_Count : Real;         // Integrated fluence/dose calculation | unit=µC
         END_STRUCT;
      END_STRUCT;

      // =====================================================================
      // FROM PC: WRITE-ONLY FOR PYTHON
      // =====================================================================
      From_PC : STRUCT
         System : STRUCT
            PLC_Watchdog : Int;           // PC increments this to prove it hasn't crashed
            Cmd_Fault_Reset : Bool;       // One-shot pulse to clear latched faults
            Cmd_Enable_Safety : Bool;     // Request to pull in the hardware safety relay
            Cmd_Source_Shutdown : Bool;   // Request to shutdown the ion source
            Cmd_Cancel_Shutdown : Bool;   // Request to cancel ion source shutdown procedure
         END_STRUCT;

         Source_Extraction : STRUCT
            Cmd_Enable : Bool;
            SP_Requested_Voltage : Real;  // Requested Voltage Command | unit=kV
            Cmd_Ctrl_Mode : Int;
         END_STRUCT;

         Source_Target : STRUCT
            Cmd_Enable : Bool;
            SP_Requested_Voltage : Real;  // Requested Voltage Command | unit=kV
            Cmd_Ctrl_Mode : Int;
         END_STRUCT;

         Source_Filament : STRUCT
            Cmd_Enable : Bool;
            SP_Requested_Current : Real;  // Requested Current Command | unit=A
            Cmd_Ctrl_Mode : Int;
         END_STRUCT;

         Source_Thermionic : STRUCT
            Cmd_Enable : Bool;
            Cmd_Auto_Emission : Bool;
            SP_Requested_Current : Real;  // Requested Emission Current | unit=mA
            Cmd_Ctrl_Mode : Int;
         END_STRUCT;

         Source_Cesium : STRUCT
            Cmd_Force_Cooling : Bool;
            SP_Requested_Temp : Real;     // Requested Temperature Command | unit=°C
            Cmd_Ctrl_Mode : Int;
            Testing_Cmd_Force_Duty_Cycle : Bool;
            Testing_Cmd_Duty_Cycle_Value : Real; // Forced Manual PID Output | unit=%
         END_STRUCT;

         Source_Chamber : STRUCT
            Cmd_Open_GV : Bool;
            Stat_Vac_OK_For_GV : Bool;
         END_STRUCT;

         Beamline_Steering : STRUCT
            Cmd_Enable : Bool;
            SP_Requested_X_Volts : Real;  // Requested X-Deflection | unit=V
            SP_Requested_Y_Volts : Real;  // Requested Y-Deflection | unit=V
            Cmd_Ctrl_Mode : Int;
         END_STRUCT;

         Beamline_Diagnostics : STRUCT
            Cmd_Insert_FC : Bool;
            Cmd_Ctrl_Mode : Int;
         END_STRUCT;

         // ==================================================================
         // CONSOLIDATED EQUIPMENT STATUS FLAGS (Vertical ISA-95 Layout)
         // Evaluated by PC Microservices via Serial/TCP, latched here
         // ==================================================================

         Source_Turbo_Pump : STRUCT
            Stat_Trip : Bool;
            Stat_Comms_Fail : Bool;
            Stat_Error : Bool;
            Stat_Warning : Bool;
         END_STRUCT;

         Loadlock_Turbo_Pump : STRUCT
            Stat_Trip : Bool;
            Stat_Comms_Fail : Bool;
            Stat_Error : Bool;
            Stat_Warning : Bool;
         END_STRUCT;

         Source_Einzel : STRUCT
            Stat_Comms_Fail : Bool;
            Stat_OverCurrent : Bool;
            Stat_OverVoltage : Bool;
            Stat_Fail : Bool;
            Stat_Arc_Exceeded : Bool;
         END_STRUCT;

         Beamline_Einzel : STRUCT
            Stat_Comms_Fail : Bool;
            Stat_OverCurrent : Bool;
            Stat_OverVoltage : Bool;
            Stat_Fail : Bool;
            Stat_Arc_Exceeded : Bool;
         END_STRUCT;

         Beamline_Neutral_Trap_Pos : STRUCT
            Stat_Comms_Fail : Bool;
            Stat_OverCurrent : Bool;
            Stat_OverVoltage : Bool;
            Stat_Fail : Bool;
            Stat_Arc_Exceeded : Bool;
         END_STRUCT;

         Beamline_Neutral_Trap_Neg : STRUCT
            Stat_Comms_Fail : Bool;
            Stat_OverCurrent : Bool;
            Stat_OverVoltage : Bool;
            Stat_Fail : Bool;
            Stat_Arc_Exceeded : Bool;
         END_STRUCT;

         Beamline_Magnet : STRUCT
            Stat_Comms_Fail : Bool;
            Stat_Short_Circuit : Bool;
            Stat_Open_Circuit : Bool;
            Stat_Unexpected_Res : Bool;
            Stat_PSU_Overtemp : Bool;
            Stat_PSU_PowerFail : Bool;
            Stat_PSU_OVP : Bool;
            Stat_PSU_OVC : Bool;
         END_STRUCT;

         Facilities_Graphix1 : STRUCT
            Stat_Comms_Fail : Bool;
         END_STRUCT;

         Facilities_Graphix2 : STRUCT
            Stat_Comms_Fail : Bool;
         END_STRUCT;

         Source_Vacuum_Gauge_1 : STRUCT
            Stat_Not_Found : Bool;
            Stat_Mismatch : Bool;
            Stat_Above_SP : Bool;
            Stat_Rapid_Rise : Bool;
         END_STRUCT;

         Beamline_Vacuum_Gauge_2 : STRUCT
            Stat_Not_Found : Bool;
            Stat_Mismatch : Bool;
            Stat_Above_SP : Bool;
            Stat_Rapid_Rise : Bool;
         END_STRUCT;

         Beamline_Vacuum_Gauge_3 : STRUCT
            Stat_Not_Found : Bool;
            Stat_Mismatch : Bool;
            Stat_Above_SP : Bool;
            Stat_Rapid_Rise : Bool;
         END_STRUCT;

         Endstation_Vacuum_Gauge_4 : STRUCT
            Stat_Not_Found : Bool;
            Stat_Mismatch : Bool;
            Stat_Above_SP : Bool;
            Stat_Rapid_Rise : Bool;
         END_STRUCT;

         Loadlock_Vacuum_Gauge_5 : STRUCT
            Stat_Not_Found : Bool;
            Stat_Mismatch : Bool;
            Stat_Above_SP : Bool;
            Stat_Rapid_Rise : Bool;
         END_STRUCT;

         Endstation_Vacuum_Gauge_6 : STRUCT
            Stat_Not_Found : Bool;
            Stat_Mismatch : Bool;
            Stat_Above_SP : Bool;
            Stat_Rapid_Rise : Bool;
         END_STRUCT;

      END_STRUCT;

      // =====================================================================
      // INTERNAL MACHINE STATE
      // Used for cross-block communication. Not used by Python.
      // =====================================================================
      Internal : STRUCT
         Target_Min_Voltage : Real;
         Cs_Heating_Permissive : Bool;
         Cs_Is_Hot : Bool;
         Fil_Is_Hot : Bool;
         Seq_Cmd_Kill_Relay : Bool;
         Seq_Cmd_Force_Cooler : Bool;
         Seq_Cmd_Open_GV : Bool;
         Seq_Ext_SP : Real;
         Seq_Tgt_SP : Real;
         Seq_Fil_SP : Real;
         Req_Cs_Active_Cooling : Bool;
         Ext_Is_Quenching : Bool;
         Tgt_Is_Quenching : Bool;
         Thm_Is_Quenching : Bool;
      END_STRUCT;
   END_STRUCT;
BEGIN
END_DATA_BLOCK

DATA_BLOCK "DB_PC_Retain"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   STRUCT
      // =====================================================================
      // NON-VOLATILE MEMORY (RETAINED)
      // Python NEVER reads or writes to this block.
      // Used by PLC to restore modes/setpoints after a power cycle (Warm Start)
      // so the operator/Recipe Manager doesn't lose context.
      // =====================================================================
      Faults : STRUCT
            Word_0 : "UDT_Fault_Word_0_System";
            Word_1 : "UDT_Fault_Word_1_Pumps";
            Word_2 : "UDT_Fault_Word_2_Source";
            Word_3 : "UDT_Fault_Word_3_Spellman";
            Word_4 : "UDT_Fault_Word_4_Magnet";
            Word_5 : "UDT_Fault_Word_5_Gauges";
      END_STRUCT;

      Settings : STRUCT
         // Retained Requested Setpoints
         Ext_SP_Requested_Voltage : Real;
         Target_SP_Requested_Voltage : Real;
         Filament_SP_Requested_Current : Real;
         Thermionic_SP_Requested_Current : Real;
         Cesium_SP_Requested_Temp : Real;
         Steering_SP_Requested_X : Real;
         Steering_SP_Requested_Y : Real;

         // Retained Control Modes (Prevents Recipe Manager from dropping out)
         Ext_Ctrl_Mode : Int;
         Target_Ctrl_Mode : Int;
         Filament_Ctrl_Mode : Int;
         Thermionic_Ctrl_Mode : Int;
         Cesium_Ctrl_Mode : Int;

         // Retained last known readbacks
         Fil_Thermal_Amps : Real;       // Virtual thermal mass of the filament
         Cs_Thermal_Temp : Real;        // Virtual thermal mass of the Cesium oven
      END_STRUCT;

      Endstation : STRUCT
         RB_Dose_Count : Real;            // Retain integrated dose to prevent data loss
      END_STRUCT;

      System : STRUCT
        Safety_Relay_Prev_State : Bool;
      END_STRUCT;
   END_STRUCT;
BEGIN
END_DATA_BLOCK