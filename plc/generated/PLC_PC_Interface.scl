DATA_BLOCK "DB_PC_Interface"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT
      // =====================================================================
      // TO PC: READ-ONLY FOR PYTHON
      // The PLC continuously overwrites this from its internal Retain/Memory
      // =====================================================================
      To_PC : STRUCT
         System : STRUCT
            PC_PLC_Comms_Lost : Bool;
            Remote_IO_Lost : Bool;
            Src_Auto_SDown : Bool;
            Machine_State : Int;
            PLC_Cycle_Count : DInt;
         END_STRUCT;

         Faults : STRUCT
            Word_0 : "UDT_Fault_Word_0_System";
            Word_1 : "UDT_Fault_Word_1_Pumps";
            Word_2 : "UDT_Fault_Word_2_Source";
            Word_3 : "UDT_Fault_Word_3_Spellman";
            Word_4 : "UDT_Fault_Word_4_Magnet";
            Word_5 : "UDT_Fault_Word_5_Gauges";
         END_STRUCT;

         Facilities : STRUCT
            Safety_Relay_Active : Bool;
            Stat_Src_Coolant_OK : Bool;
            Stat_Air_Press_OK : Bool;
         END_STRUCT;

         Source_Extraction : STRUCT
            Stat_Enabled : Bool;
            RB_Voltage : Real;
            RB_Current : Real;
         END_STRUCT;

         Source_Target : STRUCT
            Stat_Enabled : Bool;
            RB_Voltage : Real;
            RB_Current : Real;
         END_STRUCT;

         Source_Filament : STRUCT
            Stat_Enabled : Bool;
            RB_Voltage : Real;
            RB_Current : Real;
         END_STRUCT;

         Source_Thermionic : STRUCT
            Stat_Enabled : Bool;
            Stat_Auto_Emission : Bool;
            RB_Voltage : Real;
            RB_Current : Real;
         END_STRUCT;

         Source_Cesium : STRUCT
            RB_Temp : Real;
            Stat_Enabled : Bool;
         END_STRUCT;

         Source_Chamber : STRUCT
            Stat_GV_Open : Bool;
            Stat_GV_Closed : Bool;
            RB_Body_Temp : Real;
         END_STRUCT;

         Endstation : STRUCT
            RB_Dose_Count : Real;
         END_STRUCT;
      END_STRUCT;

      // =====================================================================
      // FROM PC: WRITE-ONLY FOR PYTHON
      // The PLC reads this, but NEVER blindly overwrites it.
      // =====================================================================
      From_PC : STRUCT
         System : STRUCT
            PLC_Watchdog : Bool;
            Cmd_Fault_Reset : Bool;
         END_STRUCT;

         Source_Extraction : STRUCT
            Cmd_Enable : Bool;
            SP_Voltage : Real;
         END_STRUCT;

         Source_Target : STRUCT
            Cmd_Enable : Bool;
            SP_Voltage : Real;
         END_STRUCT;

         Source_Filament : STRUCT
            Cmd_Enable : Bool;
            SP_Current : Real;
         END_STRUCT;

         Source_Thermionic : STRUCT
            Cmd_Enable : Bool;
            Cmd_Auto_Emission : Bool;
            SP_Current : Real;
         END_STRUCT;

         Source_Cesium : STRUCT
            Cmd_Stop_Cooler : Bool;
            SP_Temp : Real;
         END_STRUCT;

         Source_Chamber : STRUCT
            Cmd_Open_GV : Bool;
         END_STRUCT;

         Beamline_Steering : STRUCT
            SP_X_Volts : Real;
            SP_Y_Volts : Real;
         END_STRUCT;

         Beamline_Diagnostics : STRUCT
            Cmd_Insert_FC : Bool;
         END_STRUCT;

         // PC evaluates serial/network data and writes Bools here for PLC to latch
         Pump_Status : STRUCT
            Stat_Src_Turbo_Trip : Bool;
            Stat_Src_Turbo_Comms_Fail : Bool;
            Stat_Src_Turbo_Error : Bool;
            Stat_Src_Turbo_Warning : Bool;
            Stat_Ldlk_Turbo_Trip : Bool;
            Stat_Ldlk_Turbo_Comms_Fail : Bool;
            Stat_Ldlk_Turbo_Error : Bool;
            Stat_Ldlk_Turbo_Warning : Bool;
         END_STRUCT;

         Spellman_Status : STRUCT
            Stat_Unit1_Comms_Fail : Bool;
            Stat_Unit1_OverCurrent : Bool;
            Stat_Unit1_OverVoltage : Bool;
            Stat_Unit1_Fail : Bool;
            Stat_Unit1_Arc_Exceeded : Bool;

            Stat_Unit2_Comms_Fail : Bool;
            Stat_Unit2_OverCurrent : Bool;
            Stat_Unit2_OverVoltage : Bool;
            Stat_Unit2_Fail : Bool;
            Stat_Unit2_Arc_Exceeded : Bool;

            Stat_Unit3_Comms_Fail : Bool;
            Stat_Unit3_OverCurrent : Bool;
            Stat_Unit3_OverVoltage : Bool;
            Stat_Unit3_Fail : Bool;
            Stat_Unit3_Arc_Exceeded : Bool;

            Stat_Unit4_Comms_Fail : Bool;
            Stat_Unit4_OverCurrent : Bool;
            Stat_Unit4_OverVoltage : Bool;
            Stat_Unit4_Fail : Bool;
            Stat_Unit4_Arc_Exceeded : Bool;

            Stat_Unit5_Comms_Fail : Bool;
            Stat_Unit5_OverCurrent : Bool;
            Stat_Unit5_OverVoltage : Bool;
            Stat_Unit5_Fail : Bool;
            Stat_Unit5_Arc_Exceeded : Bool;
         END_STRUCT;

         Magnet_Status : STRUCT
            Stat_Comms_Fail : Bool;
            Stat_Short_Circuit : Bool;
            Stat_Open_Circuit : Bool;
            Stat_Unexpected_Res : Bool;
         END_STRUCT;

         Gauges_Status : STRUCT
            Stat_Graphix1_Comms_Fail : Bool;
            Stat_Graphix2_Comms_Fail : Bool;
            Stat_VG1_Not_Found : Bool;
            Stat_VG1_Mismatch : Bool;
            Stat_VG1_Above_SP : Bool;
            Stat_VG1_Rapid_Rise : Bool;
            Stat_VG2_Not_Found : Bool;
            Stat_VG2_Mismatch : Bool;
            Stat_VG2_Above_SP : Bool;
            Stat_VG2_Rapid_Rise : Bool;
            Stat_VG3_Not_Found : Bool;
            Stat_VG3_Mismatch : Bool;
            Stat_VG3_Above_SP : Bool;
            Stat_VG3_Rapid_Rise : Bool;
            Stat_VG4_Not_Found : Bool;
            Stat_VG4_Mismatch : Bool;
            Stat_VG4_Above_SP : Bool;
            Stat_VG4_Rapid_Rise : Bool;
            Stat_VG5_Not_Found : Bool;
            Stat_VG5_Mismatch : Bool;
            Stat_VG5_Above_SP : Bool;
            Stat_VG5_Rapid_Rise : Bool;
            Stat_VG6_Not_Found : Bool;
            Stat_VG6_Mismatch : Bool;
            Stat_VG6_Above_SP : Bool;
            Stat_VG6_Rapid_Rise : Bool;
         END_STRUCT;

      END_STRUCT;
   END_STRUCT;
BEGIN
END_DATA_BLOCK

DATA_BLOCK "DB_PC_Retain"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   STRUCT
      // =====================================================================
      // NON-VOLATILE MEMORY
      // Python NEVER reads or writes to this block. It is purely for the PLC
      // to store setpoints and faults during power loss.
      // =====================================================================
      Faults : STRUCT
            Word_0 : "UDT_Fault_Word_0_System";
            Word_1 : "UDT_Fault_Word_1_Pumps";
            Word_2 : "UDT_Fault_Word_2_Source";
            Word_3 : "UDT_Fault_Word_3_Spellman";
            Word_4 : "UDT_Fault_Word_4_Magnet";
            Word_5 : "UDT_Fault_Word_5_Gauges";
      END_STRUCT;

      Settings : STRUCT
         Ext_Voltage_SP : Real;
         Target_Voltage_SP : Real;
         Filament_Current_SP : Real;
         Thermionic_Current_SP : Real;
         Cesium_Temp_SP : Real;
         Steering_X_SP : Real;
         Steering_Y_SP : Real;
      END_STRUCT;

      Endstation : STRUCT
         RB_Dose_Count : Real;
      END_STRUCT;
   END_STRUCT;
BEGIN
END_DATA_BLOCK