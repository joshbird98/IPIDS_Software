DATA_BLOCK "hmiDB"
TITLE = hmiDB
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : JB
VERSION : 0.1
NON_RETAIN
//Contains all the tags that a HMI will need to interact with, sorted in sections. Each cycle, the inputs are read, and the outputs are updated.
   STRUCT 
      system : Struct
         general : Struct
            errorPLC { ExternalWritable := 'False'} : Bool;   // Shows error in the PLC
            requestClearFaults : Bool;   // Button input, to clear faults
            systemFault { ExternalWritable := 'False'} : Bool;   // Indicator, to show if fault is present
            faultCount { ExternalWritable := 'False'} : Int;   // Count of how many faults are present
            coolantStatus { ExternalWritable := 'False'} : Bool;   // Indicator, to show if coolant is active
            faultArray { ExternalWritable := 'False'} : Array[0..100] of Bool;
            messageBuffer { ExternalWritable := 'False'} : Array[0..29] of Int;
            bufferIndex { ExternalWritable := 'False'} : Int;
         END_STRUCT;
         ionSource : Struct
            general : Struct
               status : Int;   // Status, enabled=+1, fault=+2
               modeCurrent { ExternalWritable := 'False'} : Int;   // Display field showing source mode
               requestStart : Bool;   // Button input, to start the source
               requestStop : Bool;   // Button input, to stop the source
               requestCondition : Bool;   // Tickbox input
               conditioningPaused { ExternalWritable := 'False'} : Bool;   // Indicator, to show if conditioning has paused
               requestPause : Bool;   // Button input, to pause the source
               requestResume : Bool;   // Button input, to resume the source
               bodyTempC { ExternalWritable := 'False'} : Real;   // Display number, showing source temperature
               bodyTempOkay { ExternalWritable := 'False'} : Bool;   // Indicator, to show if source is cold enough - affects colour of above number
               beamVoltage { ExternalWritable := 'False'} : Real;
               doorStatus : Bool;
            END_STRUCT;
            ioniser : Struct
               status { ExternalWritable := 'False'} : Int;   // Status for ioniser, enabled=+1, fault=+2
               hmiSetpointWEnabled { ExternalWritable := 'False'} : Bool;   // Determines if power setpoint can be written too by HMI
               hmiSetpointWEntry : Real;   // Entry field, to set ioniser power
               hmiSetpointWEntryMin { ExternalWritable := 'False'} : Real;
               hmiSetpointWEntryMax { ExternalWritable := 'False'} : Real;
               readbackW { ExternalWritable := 'False'} : Real;   // Display field, showing ioniser power
               powerRatio : Real;
               filament : Struct
                  status : Int;   // Status, enabled=+1, fault=+2
                  readbackV : Real;
                  readbackA : Real;
                  readbackW : Real;
               END_STRUCT;
               thermionic : Struct
                  status : Int;   // Status, enabled=+1, fault=+2
                  readbackV : Real;
                  readbackA : Real;
                  readbackW : Real;
               END_STRUCT;
            END_STRUCT;
            target : Struct
               status { ExternalWritable := 'False'} : Int;   // Status for target, 0=off/disabled, 1=on/enabled, 2=fault
               hmiSetpointVEnabled { ExternalWritable := 'False'} : Bool;   // Determines if voltage setpoint can be written too by HMI
               hmiSetpointVEntry : Real;   // Entry field, to set target voltage
               hmiSetpointVEntryMin { ExternalWritable := 'False'} : Real;
               hmiSetpointVEntryMax { ExternalWritable := 'False'} : Real;
               readbackV { ExternalWritable := 'False'} : Real;   // Display field, showing target voltage
               readbackA { ExternalWritable := 'False'} : Real;   // Display field, showing target current
               readbackW { ExternalWritable := 'False'} : Real;   // Display field, showing target power
            END_STRUCT;
            extraction : Struct
               status { ExternalWritable := 'False'} : Int;   // Status for extraction, 0=off/disabled, 1=on/enabled, 2=fault
               hmiSetpointVEnabled { ExternalWritable := 'False'} : Bool;   // Determines if extraction setopint can be written too by HMI
               hmiSetpointVEntry : Real;   // Entry field, to set extraction voltage
               hmiSetpointVEntryMin { ExternalWritable := 'False'} : Real;
               hmiSetpointVEntryMax { ExternalWritable := 'False'} : Real;
               readbackV { ExternalWritable := 'False'} : Real;   // Display field, showing extraction voltage
               readbackA { ExternalWritable := 'False'} : Real;   // Display field, showing extraction current
               readbackW { ExternalWritable := 'False'} : Real;   // Display field, showing extraction power
            END_STRUCT;
            cesium : Struct
               status { ExternalWritable := 'False'} : Int;   // Status for cesium, 0=off/disabled, 1=on/enabled, 2=fault
               hmiSetpointCEnabled { ExternalWritable := 'False'} : Bool;   // Determines if temperature setpoint can be written too by HMI
               hmiSetpointCEntry : Real;   // Entry field, to set cesium temperature
               hmiSetpointCEntryMin { ExternalWritable := 'False'} : Real;
               hmiSetpointCEntryMax { ExternalWritable := 'False'} : Real;
               readbackC { ExternalWritable := 'False'} : Real;   // Display field, showing cesium temperature
               heaterOn { ExternalWritable := 'False'} : Bool;   // Indicator, to show if heat is being applied
               coolantOn { ExternalWritable := 'False'} : Bool;   // Indicator, to show if coolant is active
            END_STRUCT;
         END_STRUCT;
         vacuumSystem : Struct
            gauges : Struct
               source : Struct
                  readback_mB : Real;
                  status : Bool;
               END_STRUCT;
               beamline : Struct
                  readback_mB : Real;
                  status : Bool;
               END_STRUCT;
               chamber_UHV_gauge : Struct
                  readback_mB : Bool;
                  status : Bool;
               END_STRUCT;
               chamber_reg_gauge : Struct
                  readback_mB : Real;
                  status : Bool;
               END_STRUCT;
            END_STRUCT;
            pumps : Struct
               roughing { ExternalWritable := 'False'} : Struct
                  source { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                  END_STRUCT;
                  beamline { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                  END_STRUCT;
                  loadlock { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                  END_STRUCT;
               END_STRUCT;
               turbo { ExternalWritable := 'False'} : Struct
                  source_1 { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                     speed { ExternalWritable := 'False'} : Real;
                     on_hours { ExternalWritable := 'False'} : Real;
                  END_STRUCT;
                  source_2 { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                     speed { ExternalWritable := 'False'} : Real;
                     on_hours { ExternalWritable := 'False'} : Real;
                  END_STRUCT;
                  beamline { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                     speed { ExternalWritable := 'False'} : Real;
                     on_hours { ExternalWritable := 'False'} : Real;
                  END_STRUCT;
                  chamber { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                     speed { ExternalWritable := 'False'} : Real;
                     on_hours { ExternalWritable := 'False'} : Real;
                  END_STRUCT;
                  loadlock { ExternalWritable := 'False'} : Struct
                     status { ExternalWritable := 'False'} : Bool;
                     speed { ExternalWritable := 'False'} : Real;
                     on_hours { ExternalWritable := 'False'} : Real;
                  END_STRUCT;
               END_STRUCT;
               titanium : Struct
                  chamber_1 : Struct
                     on_time_s : Real;
                     off_time_s : Real;
                     nominal_current_A : Real;
                     filament_1 : Struct
                        status : Bool;
                        on_hours : Real;
                        cycles : Int;
                     END_STRUCT;
                  END_STRUCT;
               END_STRUCT;
               ion : Struct
                  chamber_1 : Struct
                     voltage_readback_V : Real;
                     current_readback_A : Real;
                     on_hours : Real;
                  END_STRUCT;
               END_STRUCT;
            END_STRUCT;
            valves : Struct
               gate : Struct
                  "source-beamline" : Struct
                     open : Bool;
                     cycles : Int;
                     requestOpen : Bool;
                  END_STRUCT;
                  "beamline-chamber" : Struct
                     open : Bool;
                     cycles : Int;
                     requestOpen : Bool;
                  END_STRUCT;
                  "chamber-loadlock" : Struct
                     open : Bool;
                     cycles : Int;
                  END_STRUCT;
               END_STRUCT;
               pneumatic : Struct
                  placeholder : Bool;
               END_STRUCT;
            END_STRUCT;
         END_STRUCT;
         beamline : Struct
            magnet : Struct
               status : Int;
               static_active : Bool;
               hmiSetpointAEnabled : Bool;
               hmiSetpointAEntry : Real;
               hmiSetpointAEntryMin : Real;
               hmiSetpointAEntryMax : Real;
               readbackV : Real;
               readbackA : Real;
               outputEnabled : Bool;
               fault : Bool;
            END_STRUCT;
            steerers : Struct
               x : Struct
                  status : Bool;
                  hmiSetpointVEnabled : Bool;
                  hmiSetpointVEntry : Real;
                  hmiSetpointVEntryMin : Real;
                  hmiSetpointVEntryMax : Real;
                  readbackV : Real;
                  readbackA : Real;
                  outputEnabled : Bool;
                  fault : Bool;
               END_STRUCT;
               y : Struct
                  status : Bool;
                  hmiSetpointVEnabled : Bool;
                  hmiSetpointVEntry : Real;
                  hmiSetpointVEntryMin : Real;
                  hmiSetpointVEntryMax : Real;
                  readbackV : Real;
                  readbackA : Real;
                  outputEnabled : Bool;
                  fault : Bool;
               END_STRUCT;
            END_STRUCT;
            einzels : Struct
               lens1 : Struct
                  status : Bool;
                  hmiSetpointVEnabled : Bool;
                  hmiSetpointVEntry : Real;
                  hmiSetpointVEntryMin : Real;
                  hmiSetpointVEntryMax : Real;
                  readbackV : Real;
                  readbackA : Real;
                  outputEnabled : Bool;
                  fault : Bool;
               END_STRUCT;
               lens2 : Struct
                  status : Bool;
                  hmiSetpointVEnabled : Bool;
                  hmiSetpointVEntry : Real;
                  hmiSetpointVEntryMin : Real;
                  hmiSetpointVEntryMax : Real;
                  readbackV : Real;
                  readbackA : Real;
                  outputEnabled : Bool;
                  fault : Bool;
               END_STRUCT;
               lens3 : Struct
                  status : Bool;
                  hmiSetpointVEnabled : Bool;
                  hmiSetpointVEntry : Real;
                  hmiSetpointVEntryMin : Real;
                  hmiSetpointVEntryMax : Real;
                  readbackV : Real;
                  readbackA : Real;
                  outputEnabled : Bool;
                  fault : Bool;
               END_STRUCT;
            END_STRUCT;
            mass_slits : Struct
               left_position : Real;
               right_position : Real;
               gap_width_mm : Real;
               gap_offset_mm : Real;
               bias_voltage : Real;
            END_STRUCT;
            drop_in_cup : Struct
               engaged : Bool;
               requestEngaged : Bool;
               readbackA : Real;
               readbackV : Real;
               hmiSetpointVEntry : Real;
               hmiSetpointVEntryMin : Real;
               hmiSetpointVEntryMax : Real;
            END_STRUCT;
            straight_thru_cup : Struct
               readbackA : Real;
            END_STRUCT;
            massScan : Struct
               requestStart : Bool;
               requestStop : Bool;
               settings : Struct
                  startCurrent : Real;
                  stopCurrent : Real;
                  stepTime : Time;
                  totalSteps : UInt;
                  hystersisWait : Time;
               END_STRUCT;
               feedback : Struct
                  currentStep : UInt;
                  remainingTime_m : UInt;
                  remainingTime_s : UInt;
                  status : Int;   // 0=Idle, 1=Zeroing, 2=Scanning, 99=Error
                  sweepActive : Bool;
                  resultsReady : Bool;
               END_STRUCT;
            END_STRUCT;
         END_STRUCT;
         endstation : Struct
            neutral_trap : Struct
               status : Bool;
               hmiSetpointLeftVEnabled : Bool;
               hmiSetpointLeftVEntry : Real;
               hmiSetpointLeftVEntryMin : Real;
               hmiSetpointLeftVEntryMax : Real;
               readbackLeftV : Real;
               readbackLeftA : Real;
               hmiSetpointRightVEnabled : Bool;
               hmiSetpointRightVEntry : Real;
               hmiSetpointRightVEntryMin : Real;
               hmiSetpointRightVEntryMax : Real;
               readbackRightV : Real;
               readbackRightA : Real;
               fault : Bool;
            END_STRUCT;
            stage : Struct
               motion : Struct
                  status : Int;
                  setpoint_x_mm : Real;
                  setpoint_y_mm : Real;
                  setpoint_z_mm : Real;
                  setpoint_angle_deg : Real;
                  readback_x_mm : Real;
                  readback_y_mm : Real;
                  readback_z_mm : Real;
                  readback_angle_deg : Real;
               END_STRUCT;
               electrical : Struct
                  bias : Real;
                  measured_current_A : Real;
               END_STRUCT;
            END_STRUCT;
            sample : Struct
               status : Int;
               reference_number : Int;
               requested_temp_C : Real;
               measured_temp_C : Real;
               requested_fluence_ions_cm2 : Real;
               measured_fluence_ions_cm2 : Real;
            END_STRUCT;
         END_STRUCT;
      END_STRUCT;
   END_STRUCT;


BEGIN
   system.general.errorPLC := false;
   system.general.requestClearFaults := false;
   system.general.systemFault := false;
   system.general.faultCount := 0;
   system.general.coolantStatus := false;
   system.general.messageBuffer[0] := 0;
   system.general.messageBuffer[1] := 0;
   system.general.messageBuffer[2] := 0;
   system.general.messageBuffer[3] := 0;
   system.general.messageBuffer[4] := 0;
   system.general.messageBuffer[5] := 0;
   system.general.messageBuffer[6] := 0;
   system.general.messageBuffer[7] := 0;
   system.general.messageBuffer[8] := 0;
   system.general.messageBuffer[9] := 0;
   system.general.messageBuffer[10] := 0;
   system.general.messageBuffer[11] := 0;
   system.general.messageBuffer[12] := 0;
   system.general.messageBuffer[13] := 0;
   system.general.messageBuffer[14] := 0;
   system.general.messageBuffer[15] := 0;
   system.general.messageBuffer[16] := 0;
   system.general.messageBuffer[17] := 0;
   system.general.messageBuffer[18] := 0;
   system.general.messageBuffer[19] := 0;
   system.general.messageBuffer[20] := 0;
   system.general.messageBuffer[21] := 0;
   system.general.messageBuffer[22] := 0;
   system.general.messageBuffer[23] := 0;
   system.general.messageBuffer[24] := 0;
   system.general.messageBuffer[25] := 0;
   system.general.messageBuffer[26] := 0;
   system.general.messageBuffer[27] := 0;
   system.general.messageBuffer[28] := 0;
   system.general.messageBuffer[29] := 0;
   system.general.bufferIndex := 0;
   system.ionSource.general.modeCurrent := 0;
   system.ionSource.general.requestStart := false;
   system.ionSource.general.requestStop := false;
   system.ionSource.general.requestCondition := false;
   system.ionSource.general.conditioningPaused := false;
   system.ionSource.general.requestPause := false;
   system.ionSource.general.requestResume := false;
   system.ionSource.general.bodyTempC := 0.0;
   system.ionSource.general.bodyTempOkay := false;
   system.ionSource.general.beamVoltage := 0.0;
   system.ionSource.ioniser.status := 0;
   system.ionSource.ioniser.hmiSetpointWEnabled := false;
   system.ionSource.ioniser.hmiSetpointWEntry := 0.0;
   system.ionSource.ioniser.hmiSetpointWEntryMin := 0.0;
   system.ionSource.ioniser.hmiSetpointWEntryMax := 0.0;
   system.ionSource.ioniser.readbackW := 0.0;
   system.ionSource.target.status := 0;
   system.ionSource.target.hmiSetpointVEnabled := false;
   system.ionSource.target.hmiSetpointVEntry := 0.0;
   system.ionSource.target.hmiSetpointVEntryMin := 0.0;
   system.ionSource.target.hmiSetpointVEntryMax := 0.0;
   system.ionSource.target.readbackV := 0.0;
   system.ionSource.target.readbackA := 0.0;
   system.ionSource.target.readbackW := 0.0;
   system.ionSource.extraction.status := 0;
   system.ionSource.extraction.hmiSetpointVEnabled := false;
   system.ionSource.extraction.hmiSetpointVEntry := 0.0;
   system.ionSource.extraction.hmiSetpointVEntryMin := 0.0;
   system.ionSource.extraction.hmiSetpointVEntryMax := 0.0;
   system.ionSource.extraction.readbackV := 0.0;
   system.ionSource.extraction.readbackA := 0.0;
   system.ionSource.extraction.readbackW := 0.0;
   system.ionSource.cesium.status := 0;
   system.ionSource.cesium.hmiSetpointCEnabled := false;
   system.ionSource.cesium.hmiSetpointCEntry := 40.0;
   system.ionSource.cesium.hmiSetpointCEntryMin := 0.0;
   system.ionSource.cesium.readbackC := 0.0;
   system.ionSource.cesium.heaterOn := false;
   system.ionSource.cesium.coolantOn := false;
   system.beamline.massScan.settings.startCurrent := 0.0;
   system.beamline.massScan.settings.stopCurrent := 10.0;
   system.beamline.massScan.settings.stepTime := T#1S;
   system.beamline.massScan.settings.totalSteps := 30;
   system.beamline.massScan.settings.hystersisWait := T#1000MS;
   system.beamline.massScan.feedback.remainingTime_m := 0;
   system.beamline.massScan.feedback.remainingTime_s := 0;
   system.beamline.massScan.feedback.status := 0;
   system.beamline.massScan.feedback.sweepActive := False;

END_DATA_BLOCK


