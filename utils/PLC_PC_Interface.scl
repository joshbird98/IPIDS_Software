TYPE "UDT_System"
VERSION : 0.1
   STRUCT
      PLC_Watchdog : Bool;      // unit= | mult=1.0 | scale=linear | label=Watchdog Toggle | short=Watchdog | desc=PC toggles this bit at 1Hz
      PC_PLC_Comms_Lost : Bool; // unit= | mult=1.0 | scale=linear | label=PC-PLC Comms Lost | short=PC-PLC Comms | desc=PLC sets this if PC toggle stops
      Remote_IO_Lost : Bool;    // unit= | mult=1.0 | scale=linear | label=Profinet Comms Lost | short=Profinet Comms | desc=Profinet link to remote IO lost
      Src_Auto_SDown : Bool;    // unit= | mult=1.0 | scale=linear | label=Source Auto Shutdown | short=Source Shutdown | desc=PLC sequencer is shutting down the source
      Machine_State : Int;      // unit= | mult=1.0 | scale=linear | label=Machine State | short=State | desc=0=Init, 1=Safe, 2=HV Ready, 3=HV On, 99=Fault
      PLC_Cycle_Count : DInt;   // unit= | mult=1.0 | scale=linear | label=PLC_Cyles | short=PLC Cycles | desc=Actively increments while PLC is in RUN mode
   END_STRUCT;
END_TYPE

TYPE "UDT_Facilities"
VERSION : 0.1
   STRUCT
      Safety_Relay_Active : Bool; // unit= | mult=1.0 | scale=linear | label=HV Safety Relay | short=HV Safety | desc=Hardware safety relay for High-Voltage systems is engaged
      Stat_Src_Coolant_OK : Bool; // unit= | mult=1.0 | scale=linear | label=Source Coolant Flow OK | short=Src Coolant | desc=Source Syltherm loop flow is sufficient
      Stat_Air_Press_OK : Bool;   // unit= | mult=1.0 | scale=linear | label=Air Pressure OK | short=Air Press | desc=Pneumatic air pressure is sufficient
   END_STRUCT;
END_TYPE

TYPE "UDT_Source_Extraction"
VERSION : 0.1
   STRUCT
      Cmd_Enable : Bool;        // unit= | mult=1.0 | scale=linear | label=Enable HV Cmd | short=Enable | desc=Request to enable High Voltage
      SP_Voltage : Real;        // unit=kV | mult=1.0 | scale=linear | label=Extraction Voltage SP | short=V SP | desc=Extraction Voltage Setpoint
      RB_Voltage : Real;        // unit=kV | mult=1.0 | scale=linear | label=Extraction Voltage RB | short=V RB | desc=Extraction Voltage Readback
      RB_Current : Real;        // unit=mA | mult=1.0 | scale=log | label=Extraction Current RB | short=I RB | desc=Extraction Current Readback
   END_STRUCT;
END_TYPE

TYPE "UDT_Source_Target"
VERSION : 0.1
   STRUCT
      Cmd_Enable : Bool;        // unit= | mult=1.0 | scale=linear | label=Enable Target Cmd | short=Enable | desc=Request to enable Target PSU
      SP_Voltage : Real;        // unit=kV | mult=1.0 | scale=linear | label=Target Voltage SP | short=V SP | desc=Target Voltage Setpoint
      RB_Voltage : Real;        // unit=kV | mult=1.0 | scale=linear | label=Target Voltage RB | short=V RB | desc=Target Voltage Readback
      RB_Current : Real;        // unit=mA | mult=1.0 | scale=log | label=Target Current RB | short=I RB | desc=Target Current Readback
   END_STRUCT;
END_TYPE

TYPE "UDT_Source_Filament"
VERSION : 0.1
   STRUCT
      Cmd_Enable : Bool;        // unit= | mult=1.0 | scale=linear | label=Enable Filament Cmd | short=Enable | desc=Request to enable Filament PSU
      SP_Current : Real;          // unit=A | mult=1.0 | scale=linear | label=Filament Current SP | short=I SP | desc=Filament Current Setpoint
      RB_Voltage : Real;        // unit=V | mult=1.0 | scale=linear | label=Filament Voltage RB | short=V RB | desc=Filament Voltage Readback
      RB_Current : Real;        // unit=A | mult=1.0 | scale=linear | label=Filament Current RB | short=I RB | desc=Filament Current Readback
   END_STRUCT;
END_TYPE

TYPE "UDT_Source_Thermionic"
VERSION : 0.1
   STRUCT
      Cmd_Enable : Bool;        // unit= | mult=1.0 | scale=linear | label=Enable Thermionic Cmd | short=Enable | desc=Request to enable Thermionic PSU
      Cmd_Auto_Emission : Bool; // unit= | mult=1.0 | scale=linear | label=Auto Emission Mode | short=Auto Em | desc=Enable PLC closed-loop emission control
      SP_Current : Real;        // unit=mA | mult=1.0 | scale=linear | label=Emission Current SP | short=Emiss SP | desc=Target Thermionic Emission Current
      RB_Voltage : Real;        // unit=V | mult=1.0 | scale=linear | label=Thermionic Voltage RB | short=V RB | desc=Thermionic Voltage Readback
      RB_Current : Real;        // unit=mA | mult=1.0 | scale=linear | label=Thermionic Current RB | short=I RB | desc=Thermionic Current Readback
   END_STRUCT;
END_TYPE

TYPE "UDT_Source_Cesium"
VERSION : 0.1
   STRUCT
      Cmd_Stop_Cooler : Bool;   // unit= | mult=1.0 | scale=linear | label=Stop Cs Cooler Cmd | short=Stop Cooler | desc=Request to stop Cesium air cooling
      SP_Temp : Real;           // unit=°C | mult=1.0 | scale=linear | label=Cesium Oven Temp SP | short=Temp SP | desc=Cesium Oven Temperature Setpoint
      RB_Temp : Real;           // unit=°C | mult=1.0 | scale=linear | label=Cesium Oven Temp RB | short=Temp RB | desc=Cesium Oven Temperature Readback
   END_STRUCT;
END_TYPE

TYPE "UDT_Source_Chamber"
VERSION : 0.1
   STRUCT
      Cmd_Open_GV : Bool;       // unit= | mult=1.0 | scale=linear | label=Open Source GV Cmd | short=Open GV | desc=Request to open source gate valve
      Stat_GV_Open : Bool;      // unit= | mult=1.0 | scale=linear | label=Source GV Open | short=GV Open | desc=Source gate valve is fully open
      Stat_GV_Closed : Bool;    // unit= | mult=1.0 | scale=linear | label=Source GV Closed | short=GV Closed | desc=Source gate valve is fully closed
      RB_Body_Temp : Real;      // unit=°C | mult=1.0 | scale=linear | label=Source Body Temp RB | short=Body Temp RB | desc=Source Body Temperature Readback
   END_STRUCT;
END_TYPE

TYPE "UDT_Beamline_Steering"
VERSION : 0.1
   STRUCT
      SP_X_Volts : Real;        // unit=V | mult=1.0 | scale=linear | label=X Steerer Voltage SP | short=X Volts SP | desc=X Deflection Voltage Setpoint
      SP_Y_Volts : Real;        // unit=V | mult=1.0 | scale=linear | label=Y Steerer Voltage SP | short=Y Volts SP | desc=Y Deflection Voltage Setpoint
   END_STRUCT;
END_TYPE

TYPE "UDT_Beamline_Diagnostics"
VERSION : 0.1
   STRUCT
      Cmd_Insert_FC : Bool;     // unit= | mult=1.0 | scale=linear | label=Insert FC Cmd | short=Insert FC | desc=Request to retract drop-in Faraday Cup
   END_STRUCT;
END_TYPE

TYPE "UDT_Endstation"
VERSION : 0.1
   STRUCT
      RB_Dose_Count : Real;     // unit=ions | mult=1.0 | scale=log | label=Implant Dose | short=Dose | desc=Accumulated Implant Dose (Retained)
   END_STRUCT;
END_TYPE

TYPE "UDT_Faults"
VERSION : 0.1
   STRUCT
      Word_0 : DWord;           // unit= | mult=1.0 | scale=linear | label=Fault Word 0 | short=Flt 0 | desc=System Faults 0-31
      Word_1 : DWord;           // unit= | mult=1.0 | scale=linear | label=Fault Word 1 | short=Flt 1 | desc=System Faults 32-63
      Word_2 : DWord;           // unit= | mult=1.0 | scale=linear | label=Fault Word 2 | short=Flt 2 | desc=System Faults 64-95
      Word_3 : DWord;           // unit= | mult=1.0 | scale=linear | label=Fault Word 3 | short=Flt 3 | desc=System Faults 96-127
   END_STRUCT;
END_TYPE

DATA_BLOCK "DB_PC_Interface"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT
      System : "UDT_System";
      Facilities : "UDT_Facilities";
      Source_Extraction : "UDT_Source_Extraction";
      Source_Target : "UDT_Source_Target";
      Source_Filament : "UDT_Source_Filament";
      Source_Thermionic : "UDT_Source_Thermionic";
      Source_Cesium : "UDT_Source_Cesium";
      Source_Chamber : "UDT_Source_Chamber";
      Beamline_Steering : "UDT_Beamline_Steering";
      Beamline_Diagnostics : "UDT_Beamline_Diagnostics";
   END_STRUCT;
BEGIN
END_DATA_BLOCK

DATA_BLOCK "DB_PC_Retain"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   STRUCT
      Faults : "UDT_Faults";
      Endstation : "UDT_Endstation";
   END_STRUCT;
BEGIN
END_DATA_BLOCK